  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415</b>\n\u041A\u0430\u043C\u0435\u0440\u044B
    \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0442 \u0432\u0430\u0441
    \u0438 \u0432\u0430\u0448\u0435 \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0434\u0430\u043D\u043D\u044B\u0435
    \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0431\u043E\u043B\u0435\u0435
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
    \u0421 \u043A\u0430\u0436\u0434\u043E\u0439 \u0432\u043E\u043B\u043D\u043E\u0439
    \u0432\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u043E\u0436\u043D\u0435\u0435.\n\nWASD
    \u2014 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435, Shift
    \u2014 \u0431\u0435\u0433, \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u043F\u0440\u044B\u0436\u043E\u043A\n\u041B\u041A\u041C
    \u2014 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C\n\u041F\u041A\u041C
    \u2014 \u0431\u043B\u043E\u043A. \u041D\u0430\u0436\u043C\u0438 \u0432 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0443\u0434\u0430\u0440\u0430 \u2014 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\n\u041F\u043E\u0441\u043B\u0435
    \u0431\u043B\u043E\u043A\u0430 \u0438\u043B\u0438 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u041B\u041A\u041C \u2014 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u0430\u044F
    \u043A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0430\n\u0412\u0440\u0430\u0433\u0438
    \u0440\u043E\u043D\u044F\u044E\u0442 \u0430\u043F\u0442\u0435\u0447\u043A\u0438\n\n1.
    \u0420\u0430\u0437\u0431\u0435\u0439 \u0432\u0441\u0435 \u043A\u0430\u043C\u0435\u0440\u044B
    \u2014 \u0432\u043E\u043B\u043D\u044B \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u044F\u0442\u0441\u044F\n2.
    \u0414\u043E\u0431\u0435\u0439 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F
    \u2014 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0432\u044B\u0445\u043E\u0434\n3.
    \u041A\u043E\u0440\u0438\u0434\u043E\u0440 \u2014 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430\u044F
    \u0437\u043E\u043D\u0430, \u043E\u0442\u0434\u044B\u0448\u0438\u0441\u044C"
